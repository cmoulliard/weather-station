        <mxCell id="wire-bus-rain" value="" style="rounded=1;html=1;strokeColor=#0000FF;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="a3144-rain" target="base">
          <mxGeometry relative="1" as="geometry">
