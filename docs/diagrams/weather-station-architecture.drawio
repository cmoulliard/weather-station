        <mxCell id="rain-label" value="&lt;b&gt;Tipping bucket rain gauge&lt;/b&gt;" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1055" y="190" width="200" height="30" as="geometry" />
