          </mxGeometry>
        </mxCell>

        <!-- Magnet -->
        <mxCell id="magnet" value="N &amp;nbsp; S" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFE0E0;strokeColor=#DC3545;fontSize=10;fontColor=#C62828;" vertex="1" parent="1">
          <mxGeometry x="1100" y="415" width="50" height="20" as="geometry" />
