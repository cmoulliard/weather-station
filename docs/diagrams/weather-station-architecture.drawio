        <!-- ==================== TIPPING BUCKET RAIN GAUGE ==================== -->
        <mxCell id="rain-gauge-box" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F8F8;strokeColor=#333333;strokeWidth=2;arcSize=4;" vertex="1" parent="1">
