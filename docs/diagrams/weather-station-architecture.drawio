        </mxCell>

        <!-- Bucket A -->
        <mxCell id="bucket-a" value="A" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#333333;strokeWidth=1.5;fontSize=11;size=5;" vertex="1" parent="1">
          <mxGeometry x="1090" y="370" width="70" height="35" as="geometry" />
        </mxCell>
        <!-- Bucket B -->
        <mxCell id="bucket-b" value="B" style="shape=trapezoid;perimeter=trapezoidPerimeter;whiteSpace=wrap;html=1;fillColor=#FAFAFA;strokeColor=#333333;strokeWidth=1.5;fontSize=11;size=5;" vertex="1" parent="1">
          <mxGeometry x="1190" y="370" width="70" height="35" as="geometry" />
