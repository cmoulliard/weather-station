        <mxCell id="wire-pulse-rain" value="" style="rounded=1;html=1;strokeColor=#7B2D8B;strokeWidth=2;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.3;entryDx=0;entryDy=0;endArrow=none;" edge="1" parent="1" source="a3144-rain" target="esp32">
          <mxGeometry relative="1" as="geometry">
