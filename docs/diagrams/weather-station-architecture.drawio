        <!-- A3144 (rain gauge) -->
        <mxCell id="a3144-rain" value="&lt;b&gt;Hall effect sensor&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px;color:#7B2D8B;&quot;&gt;A3144 · Pulse · 1/tip&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1080" y="470" width="190" height="40" as="geometry" />
