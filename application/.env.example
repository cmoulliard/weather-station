# Weather data source: "api" (OpenWeatherMap) or "mock" (simulated data)
WEATHER_DATASOURCE=api
WEATHER_CITY=Brussels

# OpenWeatherMap API key (get one free at https://openweathermap.org/api)
OPENWEATHERMAP_API_KEY=your-api-key-here

# InfluxDB v3 connection (default port: 8181)
INFLUXDB_ENABLED=true
INFLUXDB_URL=http://localhost:8181
INFLUXDB_TOKEN=your-influxdb-admin-token
INFLUXDB_DATABASE=weather
