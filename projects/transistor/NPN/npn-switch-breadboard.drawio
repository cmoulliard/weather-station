trokeColor=#d62728;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;exitX=0.76562;exitY=0.77500;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.76562;entryY=0.92500;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bb" target="bb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l15" value="← push button 12×6 mm (cols 11/13, rows d/g)" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="1090" y="269" width="350.4" height="22" as="geometry"/></mxCell><mxCell id="l16" value="← NPN: E e16 · B e17 · C e18" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="1090" y="320" width="228.79999999999998" height="22" as="geometry"/></mxCell><mxCell id="l17" value="← 10 kΩ c13–c17 · 470 Ω c20–c24" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="1090" y="389" width="251.6" height="22" as="geometry"/></mxCell><mxCell id="l18" value="← LED + a20 · − a21" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="1090" y="454" width="160.4" height="22" as="geometry"/></mxCell><mxCell id="t19" value="BPM HW-131 on the rails (pins in cols 3 and 7), jumpers on 5V (or 3.3), press the switch" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="340" y="538" width="666.72" height="21.6" as="geometry"/></mxCell><mxCell id="panel" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;fillColor=#eef1f6;strokeColor=#9aa3ab;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1380" height="330" as="geometry"/></mxCell><mxCell id="t20" value="Wires" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="61.6" height="28.8" as="geometry"/></mxCell><mxCell id="s21" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#d62728;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="636" as="sourcePoint"/><mxPoint x="106" y="636" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t22" value="5 V (+ rail) / battery +" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="625" width="190.56" height="21.6" as="geometry"/></mxCell><mxCell id="s23" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#1b1b1b;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="672" as="sourcePoint"/><mxPoint x="106" y="672" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t24" value="GND (− rail) / battery −" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="661" width="190.56" height="21.6" as="geometry"/></mxCell><mxCell id="s25" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#f28e1c;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="708" as="sourcePoint"/><mxPoint x="106" y="708" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t26" value="Collector → LED −" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="697" width="138.48000000000002" height="21.6" as="geometry"/></mxCell><mxCell id="t27" value="Schematic" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="101.28" height="28.8" as="geometry"/></mxCell><mxCell id="t28" value="+5V ─ 470 Ω ─ LED(+ → −) ─ C" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="784" width="220.32" height="21.6" as="geometry"/></mxCell><mxCell id="t29" value="                         NPN" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="806" width="220.32" height="21.6" as="geometry"/></mxCell><mxCell id="t30" value="+5V ─ button ─ 10 kΩ ──── B" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="828" width="212.88" height="21.6" as="geometry"/></mxCell><mxCell id="t31" value="                          E ─ GND" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="850" width="257.52" height="21.6" as="geometry"/></mxCell><mxCell id="t32" value="Notes" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="590" width="61.6" height="28.8" as="geometry"/></mxCell><mxCell id="t33" value="• 9 V battery → battery cable → DC jack of the BPM (HW-131). It feeds the 4 rails; jumper of each side on 5V, then press the switch." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="628" width="994.08" height="21.6" as="geometry"/></mxCell><mxCell id="t34" value="• 12×6 mm button straddles the channel (cols 11 and 13, rows d and g). Col 11 gets +5 V from the b+ rail; pressing links col 11 → col 13." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="660" width="1031.28" height="21.6" as="geometry"/></mxCell><mxCell id="t35" value="• Col 13 → 10 kΩ (c13 → c17) → base of the NPN (col 17). Base current ≈ (5 − 0.7) / 10 kΩ ≈ 0.43 mA (3.3 V: ≈ 0.26 mA)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="692" width="897.36" height="21.6" as="geometry"/></mxCell><mxCell id="t36" value="• Collector (col 18) → orange wire d18 → d21 → LED cathode (a21). LED anode (a20) → 470 Ω (c20 → c24) → + rail." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="724" width="837.84" height="21.6" as="geometry"/></mxCell><mxCell id="t37" value="• Emitter (col 16) → black wire → − rail. LED ≈ (5 − 2 − 0.1) / 470 Ω ≈ 6 mA at 5 V, ≈ 2.6 mA at 3.3 V." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="756" width="778.32" height="21.6" as="geometry"/></mxCell><mxCell id="t38" value="• Button released: no base current → transistor OFF → LED off. Pressed: transistor ON (saturated) → LED on." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="788" width="808.08" height="21.6" as="geometry"/></mxCell><mxCell id="t39" value="• Pinout E-B-C (flat face towards you, legs down) for S8050 / 2N2222 / PN2222. A BC547 is C-B-E: turn it 180°." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="820" width="830.4" height="21.6" as="geometry"/></mxCell><mxCell id="t40" value="• Never connect the base without its resistor. Built from projects/drawio-lib — regenerate with python3 gen_breadboard.py." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="852" width="919.68" height="21.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
