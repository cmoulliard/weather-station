tml=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="360" y="620" width="361.68" height="21.6" as="geometry"/></mxCell><mxCell id="panel" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;fillColor=#eef1f6;strokeColor=#9aa3ab;" vertex="1" parent="1"><mxGeometry x="40" y="760" width="1180" height="330" as="geometry"/></mxCell><mxCell id="t19" value="Wires" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="770" width="61.6" height="28.8" as="geometry"/></mxCell><mxCell id="s20" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#d62728;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="816" as="sourcePoint"/><mxPoint x="106" y="816" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t21" value="9 V (+ rail)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="805" width="101.28" height="21.6" as="geometry"/></mxCell><mxCell id="s22" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#1b1b1b;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="852" as="sourcePoint"/><mxPoint x="106" y="852" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t23" value="GND (− rail)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="841" width="101.28" height="21.6" as="geometry"/></mxCell><mxCell id="s24" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#f28e1c;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="888" as="sourcePoint"/><mxPoint x="106" y="888" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t25" value="Collector → LED −" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="877" width="138.48000000000002" height="21.6" as="geometry"/></mxCell><mxCell id="t26" value="Schematic" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="930" width="101.28" height="28.8" as="geometry"/></mxCell><mxCell id="t27" value="+9V ─ 1 kΩ ─ LED(+ → −) ─ C" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="964" width="212.88" height="21.6" as="geometry"/></mxCell><mxCell id="t28" value="                         NPN" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="986" width="220.32" height="21.6" as="geometry"/></mxCell><mxCell id="t29" value="+9V ─ button ─ 10 kΩ ──── B" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="1008" width="212.88" height="21.6" as="geometry"/></mxCell><mxCell id="t30" value="                          E ─ GND" style="text;html=0;align=left;verticalAlign=middle;fontFamily=Courier New;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="257.52" height="21.6" as="geometry"/></mxCell><mxCell id="t31" value="Notes" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="770" width="61.6" height="28.8" as="geometry"/></mxCell><mxCell id="t32" value="• 9 V battery feeds the bottom rails: + → b+ (red), − → b− (black). The top rails and the top half are not used." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="808" width="845.28" height="21.6" as="geometry"/></mxCell><mxCell id="t33" value="• Button straddles the channel (cols 3 and 5). Col 3 gets +9 V from the rail; pressing links col 3 → col 5." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="840" width="808.08" height="21.6" as="geometry"/></mxCell><mxCell id="t34" value="• Col 5 → 10 kΩ (h5 → h9) → base of the NPN (col 9). Base current ≈ (9 − 0.7) / 10 kΩ ≈ 0.8 mA." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="872" width="718.8" height="21.6" as="geometry"/></mxCell><mxCell id="t35" value="• Collector (col 10) → orange wire g10 → g13 → LED cathode (j13). LED anode (j12) → 1 kΩ (h12 → h16) → + rail." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="904" width="830.4" height="21.6" as="geometry"/></mxCell><mxCell id="t36" value="• Emitter (col 8) → black wire → − rail. LED current ≈ (9 − 2 − 0.1) / 1 kΩ ≈ 7 mA: the transistor is saturated." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="936" width="845.28" height="21.6" as="geometry"/></mxCell><mxCell id="t37" value="• Button released: no base current → transistor OFF → LED off. Pressed: transistor ON → LED on." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="968" width="718.8" height="21.6" as="geometry"/></mxCell><mxCell id="t38" value="• Pinout E-B-C (flat face towards you, legs down) for S8050 / 2N2222 / PN2222. A BC547 is C-B-E: turn it 180°." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1000" width="830.4" height="21.6" as="geometry"/></mxCell><mxCell id="t39" value="• Never connect the base without its resistor. Built from projects/drawio-lib — regenerate with python3 gen_breadboard.py." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1032" width="919.68" height="21.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
