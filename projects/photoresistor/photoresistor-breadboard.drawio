l=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="440" y="368" width="54.0" height="22" as="geometry"/></mxCell><mxCell id="l16" value="trimmer 3296W 100 kΩ (104) →" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="275" y="459" width="228.79999999999998" height="22" as="geometry"/></mxCell><mxCell id="l17" value="← S8050 NPN (E g7 · B g8 · C g9)" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="940" y="399" width="259.2" height="22" as="geometry"/></mxCell><mxCell id="l18" value="← LED (− f9 · + f10)" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="940" y="438" width="168.0" height="22" as="geometry"/></mxCell><mxCell id="t19" value="Power module plugs into the rails (rows 0–1), both jumpers on 5 V" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="480" y="924" width="455.3" height="19.8" as="geometry"/></mxCell><mxCell id="panel" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;fillColor=#eef1f6;strokeColor=#9aa3ab;" vertex="1" parent="1"><mxGeometry x="40" y="960" width="1240" height="300" as="geometry"/></mxCell><mxCell id="t20" value="Wires" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="970" width="61.6" height="28.8" as="geometry"/></mxCell><mxCell id="s21" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#d62728;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1016" as="sourcePoint"/><mxPoint x="106" y="1016" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t22" value="5 V (+ rail) / battery +" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="1005" width="190.56" height="21.6" as="geometry"/></mxCell><mxCell id="s23" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#1b1b1b;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1052" as="sourcePoint"/><mxPoint x="106" y="1052" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t24" value="GND (− rail) / battery −" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="1041" width="190.56" height="21.6" as="geometry"/></mxCell><mxCell id="s25" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#f2c200;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1088" as="sourcePoint"/><mxPoint x="106" y="1088" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t26" value="Pot wiper → divider node" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="1077" width="190.56" height="21.6" as="geometry"/></mxCell><mxCell id="t27" value="Notes" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="970" width="61.6" height="28.8" as="geometry"/></mxCell><mxCell id="t28" value="• 9 V battery → Freenove 9 V battery cable → DC jack of the breadboard power module. Both jumpers on 5 V (not 3.3 V), switch ON." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1008" width="964.3199999999999" height="21.6" as="geometry"/></mxCell><mxCell id="t29" value="• The module feeds the + / − rails on both sides: left rails for the trimmer and the LDR, right rails for the transistor and the LED." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1038" width="1001.52" height="21.6" as="geometry"/></mxCell><mxCell id="t30" value="• Light divider: + rail → Baoter 3296W 100 kΩ trimmer (code 104; b10 = 5 V, wiper = middle pin b11, b12 not connected) → yellow wire c11 → c8 → node row 8 (a8 LDR, c8 wire, d8 10 kΩ) → LDR → − rail." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1068" width="1485.12" height="21.6" as="geometry"/></mxCell><mxCell id="t31" value="• Node row 8 → 10 kΩ (d8 → f8, across the channel) → base of the S8050 (column g: E row 7, B row 8, C row 9)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1098" width="822.96" height="21.6" as="geometry"/></mxCell><mxCell id="t32" value="• LED: + rail → 220 Ω (row 10) → LED + (f10) / LED − (f9) → collector (row 9). Emitter (row 7) → black wire → − rail." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1128" width="882.48" height="21.6" as="geometry"/></mxCell><mxCell id="t33" value="• Set-up: in room light turn the trimmer screw (multi-turn, ~25 turns end to end) until the LED just goes OFF, then cover the LDR → the LED lights." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1158" width="1105.68" height="21.6" as="geometry"/></mxCell><mxCell id="t34" value="• S8050 (TO-92, flat face towards you, legs down) = E-B-C, left to right. Same holes for a 2N2222 / PN2222; a BC547 (C-B-E) goes in rotated 180°." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1188" width="1090.8" height="21.6" as="geometry"/></mxCell><mxCell id="t35" value="• Built from projects/drawio-lib/breadboard-electronics.xml — regenerate with python3 gen_breadboard.py." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1218" width="785.76" height="21.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
