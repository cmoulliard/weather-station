startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#f28e1c;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;exitX=0.77500;exitY=0.31944;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.77500;entryY=0.34722;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bb" target="bb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="w15" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#1b1b1b;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;exitX=0.77500;exitY=0.26389;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0.92500;entryY=0.26389;entryDx=0;entryDy=0;entryPerimeter=0;" edge="1" parent="1" source="bb" target="bb"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="l16" value="LDR →" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="440" y="428" width="54.0" height="22" as="geometry"/></mxCell><mxCell id="l17" value="trimmer 3296W 100 kΩ (104) →" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="275" y="519" width="228.79999999999998" height="22" as="geometry"/></mxCell><mxCell id="l18" value="← S8050 NPN (E g7 · B g8 · C g9)" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="940" y="459" width="259.2" height="22" as="geometry"/></mxCell><mxCell id="l19" value="← LED (− f10 · + f11) · orange j9 → j10" style="rounded=1;arcSize=50;html=1;fillColor=#e8f4fb;strokeColor=#1d2a3a;fontSize=13;fontColor=#1d2a3a;" vertex="1" parent="1"><mxGeometry x="940" y="498" width="312.4" height="22" as="geometry"/></mxCell><mxCell id="t20" value="BPM HW-131 plugs into the rails (rows 0 and 4), both jumpers on 5V" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="480" y="984" width="462.12" height="19.8" as="geometry"/></mxCell><mxCell id="panel" value="" style="rounded=1;absoluteArcSize=1;arcSize=16;html=1;fillColor=#eef1f6;strokeColor=#9aa3ab;" vertex="1" parent="1"><mxGeometry x="40" y="1020" width="1240" height="300" as="geometry"/></mxCell><mxCell id="t21" value="Wires" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="60" y="1030" width="61.6" height="28.8" as="geometry"/></mxCell><mxCell id="s22" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#d62728;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1076" as="sourcePoint"/><mxPoint x="106" y="1076" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t23" value="5 V (+ rail) / battery +" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="1065" width="190.56" height="21.6" as="geometry"/></mxCell><mxCell id="s24" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#1b1b1b;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1112" as="sourcePoint"/><mxPoint x="106" y="1112" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t25" value="GND (− rail) / battery −" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="1101" width="190.56" height="21.6" as="geometry"/></mxCell><mxCell id="s26" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#f2c200;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1148" as="sourcePoint"/><mxPoint x="106" y="1148" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t27" value="Pot wiper → divider node" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="1137" width="190.56" height="21.6" as="geometry"/></mxCell><mxCell id="s28" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#f28e1c;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1184" as="sourcePoint"/><mxPoint x="106" y="1184" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t29" value="Collector → LED −" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118" y="1173" width="138.48000000000002" height="21.6" as="geometry"/></mxCell><mxCell id="t30" value="Notes" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1030" width="61.6" height="28.8" as="geometry"/></mxCell><mxCell id="t31" value="• 9 V battery → Freenove 9 V battery cable → DC jack of the BPM (HW-131). Both jumpers on 5V (not 3.3), then press the switch." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1068" width="949.4399999999999" height="21.6" as="geometry"/></mxCell><mxCell id="t32" value="• The module feeds the + / − rails on both sides: left rails for the trimmer and the LDR, right rails for the transistor and the LED." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1098" width="1001.52" height="21.6" as="geometry"/></mxCell><mxCell id="t33" value="• Light divider: + rail → Baoter 3296W 100 kΩ trimmer (code 104; b10 = 5 V, wiper = middle pin b11, b12 not connected) → yellow wire c11 → c8 → node row 8 (a8 LDR, c8 wire, d8 10 kΩ) → LDR → − rail." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1128" width="1485.12" height="21.6" as="geometry"/></mxCell><mxCell id="t34" value="• Node row 8 → 10 kΩ (d8 → f8, across the channel) → base of the S8050 (column g: E row 7, B row 8, C row 9)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1158" width="822.96" height="21.6" as="geometry"/></mxCell><mxCell id="t35" value="• LED: + rail → 220 Ω (row 11) → LED + (f11) / LED − (f10) → orange wire j10 → j9 → collector (row 9). Emitter (row 7) → black wire → − rail." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1188" width="1061.04" height="21.6" as="geometry"/></mxCell><mxCell id="t36" value="• Set-up: in room light turn the trimmer screw (multi-turn, ~25 turns end to end) until the LED just goes OFF, then cover the LDR → the LED lights." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1218" width="1105.68" height="21.6" as="geometry"/></mxCell><mxCell id="t37" value="• S8050 (TO-92, flat face towards you, legs down) = E-B-C, left to right. Same holes for a 2N2222 / PN2222; a BC547 (C-B-E) goes in rotated 180°." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1248" width="1090.8" height="21.6" as="geometry"/></mxCell><mxCell id="t38" value="• Built from projects/drawio-lib/breadboard-electronics.xml — regenerate with python3 gen_breadboard.py." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="380" y="1278" width="785.76" height="21.6" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
