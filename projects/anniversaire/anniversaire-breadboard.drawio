ize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118.0" y="905.2" width="145.9" height="21.6" as="geometry"/></mxCell><mxCell id="s56" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#1b1b1b;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="952" as="sourcePoint"/><mxPoint x="106" y="952" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t57" value="GND (− rail)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118.0" y="941.2" width="101.3" height="21.6" as="geometry"/></mxCell><mxCell id="s58" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#f2c200;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="988" as="sourcePoint"/><mxPoint x="106" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t59" value="SCL — GPIO22" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118.0" y="977.2" width="101.3" height="21.6" as="geometry"/></mxCell><mxCell id="s60" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#2ca02c;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1024" as="sourcePoint"/><mxPoint x="106" y="1024" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t61" value="SDA — GPIO21" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118.0" y="1013.2" width="101.3" height="21.6" as="geometry"/></mxCell><mxCell id="s62" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#8e44ad;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="60" y="1060" as="sourcePoint"/><mxPoint x="106" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t63" value="Button LEFT — GPIO18" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="118.0" y="1049.2" width="160.8" height="21.6" as="geometry"/></mxCell><mxCell id="s64" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#e8559a;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="916" as="sourcePoint"/><mxPoint x="376" y="916" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t65" value="Button OK — GPIO19" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="388.0" y="905.2" width="145.9" height="21.6" as="geometry"/></mxCell><mxCell id="s66" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#e0e0e0;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="952" as="sourcePoint"/><mxPoint x="376" y="952" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t67" value="Button RIGHT — GPIO17 (TX2)" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="388.0" y="941.2" width="212.9" height="21.6" as="geometry"/></mxCell><mxCell id="s68" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#8b5a2b;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="988" as="sourcePoint"/><mxPoint x="376" y="988" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t69" value="Passive buzzer — GPIO25" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="388.0" y="977.2" width="183.1" height="21.6" as="geometry"/></mxCell><mxCell id="s70" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#8d969c;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="1024" as="sourcePoint"/><mxPoint x="376" y="1024" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t71" value="Photoresistor — GPIO35" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="388.0" y="1013.2" width="175.7" height="21.6" as="geometry"/></mxCell><mxCell id="s72" value="" style="endArrow=oval;startArrow=oval;startFill=1;endFill=1;startSize=6;endSize=6;html=1;strokeWidth=4;strokeColor=#2c74c9;rounded=1;arcSize=20;jumpStyle=arc;jumpSize=10;edgeStyle=none;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="330" y="1060" as="sourcePoint"/><mxPoint x="376" y="1060" as="targetPoint"/></mxGeometry></mxCell><mxCell id="t73" value="Pot wiper — GPIO34" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=12;fontStyle=0;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="388.0" y="1049.2" width="145.9" height="21.6" as="geometry"/></mxCell><mxCell id="t74" value="Notes" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=16;fontStyle=1;fontColor=#1d2a3a;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="620.0" y="869.6" width="61.6" height="28.8" as="geometry"/></mxCell><mxCell id="t75" value="• USB powers the ESP32; its 3V3 / GND feed the left rails, bridged to the right rails (top + bottom)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#2a3646;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="620.0" y="906.1" width="700.8" height="19.8" as="geometry"/></mxCell><mxCell id="t76" value="• I²C bus: SCL = row 7, SDA = row 10, carried across the channel; OLED + MPU-6050 share it." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#2a3646;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="620.0" y="934.1" width="632.6" height="19.8" as="geometry"/></mxCell><mxCell id="t77" value="• Buttons straddle the channel: GPIO on rows 11 / 14 / 17, GND on rows 13 / 16 / 19 (INPUT_PULLUP)." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#2a3646;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="620.0" y="962.1" width="687.2" height="19.8" as="geometry"/></mxCell><mxCell id="t78" value="• Passive buzzer (LEDC tone): GPIO25 → 100 Ω (row 22) → + ; − (row 25) → GND." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#2a3646;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="620.0" y="990.1" width="537.1" height="19.8" as="geometry"/></mxCell><mxCell id="t79" value="• Photoresistor divider: 3V3 → LDR → node row 26 (GPIO35) → 10 kΩ → GND." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#2a3646;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="620.0" y="1018.1" width="503.0" height="19.8" as="geometry"/></mxCell><mxCell id="t80" value="• Pot 10 kΩ (3386P), rows 28–30: 3V3 / wiper → GPIO34 / GND." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#2a3646;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="620.0" y="1046.1" width="421.2" height="19.8" as="geometry"/></mxCell><mxCell id="t81" value="• Built from docs/diagrams/drawio-lib/breadboard-electronics.xml." style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontStyle=0;fontColor=#2a3646;strokeColor=none;fillColor=none;whiteSpace=nowrap;" vertex="1" parent="1"><mxGeometry x="620.0" y="1074.1" width="455.3" height="19.8" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>
