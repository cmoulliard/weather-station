<mxCell id="c819" value="100 Ω → coil (pin 4)" style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="126.0" y="918.8" width="176.0" height="22.4" as="geometry"/></mxCell>
<mxCell id="c820" value="Parts" style="text;html=1;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="62.0" y="965.6" width="62.0" height="28.8" as="geometry"/></mxCell>
<mxCell id="c821" value="• HK4100F-DC5V-SHG relay (5 V coil)" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="62.0" y="1001.6" width="281.0" height="20.8" as="geometry"/></mxCell>
<mxCell id="c822" value="• 9 V battery + snap clip" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="352.0" y="1001.6" width="203.0" height="20.8" as="geometry"/></mxCell>
<mxCell id="c823" value="• Tactile push button" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="62.0" y="1029.6" width="171.8" height="20.8" as="geometry"/></mxCell>
<mxCell id="c824" value="• Resistor 100 Ω (coil) · 470 Ω (LED)" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="352.0" y="1029.6" width="288.8" height="20.8" as="geometry"/></mxCell>
<mxCell id="c825" value="• No diode (button only)" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="62.0" y="1057.6" width="195.2" height="20.8" as="geometry"/></mxCell>
<mxCell id="c826" value="• LED 5 mm red · jumper wires" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="352.0" y="1057.6" width="234.2" height="20.8" as="geometry"/></mxCell>
<mxCell id="c827" value="• Capacitor 1000 µF electrolytic, ≥16 V" style="text;html=1;fontFamily=Helvetica;fontSize=13;fontStyle=0;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="62.0" y="1085.6" width="312.2" height="20.8" as="geometry"/></mxCell>
<mxCell id="c828" value="Notes" style="text;html=1;fontFamily=Helvetica;fontSize=18;fontStyle=1;fontColor=#1d2a3a;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="815.6" width="62.0" height="28.8" as="geometry"/></mxCell>
<mxCell id="c829" value="• 9 V battery: + → left + rail, − → left − rail; rails bridged to the right side (top / bottom)." style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="854.8" width="814.4" height="22.4" as="geometry"/></mxCell>
<mxCell id="c830" value="• Press the button: + → button → 100 Ω → coil (pins 4–3) → −. The relay clicks." style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="882.8" width="671.6" height="22.4" as="geometry"/></mxCell>
<mxCell id="c831" value="• 100 Ω in series: coil gets ≈4.9 V / 41 mA (5 V coil, 120 Ω, 0.2 W; max 6.5 V, pulls in ≥3.75 V)." style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="910.8" width="831.2" height="22.4" as="geometry"/></mxCell>
<mxCell id="c832" value="• No flyback diode: OK with a push button, but REQUIRED if a transistor drives the coil." style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="938.8" width="747.2" height="22.4" as="geometry"/></mxCell>
<mxCell id="c833" value="• Contact side: COM (pins 5/6) ← + rail. NO (pin 1) closes → 470 Ω → LED → − (≈15 mA)." style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="966.8" width="713.6" height="22.4" as="geometry"/></mxCell>
<mxCell id="c834" value="• Invert: use NC (pin 2, row 15 left) instead of NO → LED on while the button is released." style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="994.8" width="764.0" height="22.4" as="geometry"/></mxCell>
<mxCell id="c835" value="• Relay straddles the channel (rows 10–15). Pin map: HKE datasheet + LCSC C12072 — check" style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="1022.8" width="747.2" height="22.4" as="geometry"/></mxCell>
<mxCell id="c836" value="   with a multimeter before wiring: coil pins ≈120 Ω, COM–NC ≈0 Ω, COM–NO open." style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="1050.8" width="671.6" height="22.4" as="geometry"/></mxCell>
<mxCell id="c837" value="• 1000 µF across the coil (+ row 14, − row 16 → − rail): relay holds ≈0.3 s after release" style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="1078.8" width="755.6" height="22.4" as="geometry"/></mxCell>
<mxCell id="c838" value="   (coil 120 Ω discharges the capacitor) — idea from C. Platt, Make Electronics, fig. 2-65/2-66." style="text;html=1;fontFamily=Helvetica;fontSize=14;fontStyle=0;fontColor=#2a3646;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;whiteSpace=nowrap;spacing=0;spacingLeft=2;spacingRight=2;" vertex="1" parent="1"><mxGeometry x="678.0" y="1106.8" width="814.4" height="22.4" as="geometry"/></mxCell>
</root></mxGraphModel></diagram></mxfile>
